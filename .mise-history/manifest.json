{
  "format": 1,
  "enrollment": [
    {
      "path": "config/config.toml",
      "autosave": true,
      "encrypt": false,
      "variants": []
    },
    {
      "path": "home/.claude",
      "autosave": true,
      "encrypt": false,
      "variants": [],
      "exclude": [
        "/skills/synced",
        ".trash"
      ],
      "include": [
        "settings.json",
        "CLAUDE.md",
        "keybindings.json",
        "commands/**",
        "agents/**",
        "skills/**"
      ]
    },
    {
      "path": "home/.config/ghostty/config.ghostty",
      "autosave": true,
      "encrypt": false,
      "variants": []
    },
    {
      "path": "home/.config/nvim",
      "autosave": true,
      "encrypt": false,
      "variants": []
    },
    {
      "path": "home/.zshrc",
      "autosave": true,
      "encrypt": false,
      "variants": []
    }
  ],
  "exclude": [],
  "recipients": [],
  "permissions": {
    "home/.claude/settings.json": 384,
    "home/.config": 489
  }
}